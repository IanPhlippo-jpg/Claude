{
  "name": "phlippo-cad",
  "private": true,
  "version": "0.5.14",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "cross-env VITE_TEST_HOOKS=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:voorbeelden": "cross-env VOORBEELDEN=1 vitest run src/qa/qaAfzuiging.test.ts src/qa/qaBureau.test.ts src/qa/qaTrein.test.ts src/qa/stlAfzuiging.test.ts src/qa/overlapBoxAfzuiging.test.ts src/qa/tekeningenAfzuiging.test.ts src/qa/tekeningenTrein.test.ts src/qa/schemaNorm.test.ts src/qa/qaRobotarm.test.ts src/qa/qaLastafel.test.ts src/qa/tekeningenLastafel.test.ts src/qa/qaDeuren.test.ts src/qa/montageDeuren.test.ts src/qa/qaBalustrades.test.ts",
    "test:afz-snel": "cross-env VOORBEELDEN=1 vitest run src/qa/qaAfzuiging.test.ts -t \"is één body|B-rep\"",
    "typecheck": "tsc -b",
    "e2e": "node e2e/smoke.mjs && node e2e/relations.mjs && node e2e/full.mjs && node e2e/features.mjs && node e2e/assembly.mjs && node e2e/drawing.mjs && node e2e/configurations.mjs && node e2e/rib.mjs && node e2e/endconditions.mjs && node e2e/multibody.mjs && node e2e/slot.mjs && node e2e/sheetmetal.mjs && node e2e/section.mjs && node e2e/sketchtools.mjs && node e2e/helix.mjs && node e2e/hem.mjs && node e2e/explode.mjs",
    "desktop": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "desktop:start": "npm run build && electron .",
    "desktop:build": "git diff --quiet && git diff --cached --quiet && npm run build && echo UNSIGNED build: no code-signing certificate is configured (the signature report follows the build) && electron-builder --win --config.directories.output=%LOCALAPPDATA%/PhlippoCAD/release && node tools/sign-report.cjs",
    "e2e:desktop": "node e2e/desktop.mjs",
    "e2e:regression": "node e2e/run-regression.mjs",
    "ci": "npm run typecheck && npm run test && npm run build",
    "check:bundle": "node tools/bundle-budget.cjs",
    "bewijs": "node tools/bewijs.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.180.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.16",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.7"
  },
  "main": "electron/main.cjs",
  "description": "Phlippo CAD - parametric CAD",
  "author": "Ian Phlippo",
  "build": {
    "appId": "be.phlippo.cad",
    "productName": "Phlippo CAD",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraFiles": [
      "LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/assets/replicad_single-*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "sign": "./tools/sign-hook.cjs",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "license": "LICENSE.txt",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Phlippo CAD",
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "kcad",
        "name": "Phlippo CAD part",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "forceCodeSigning": false
  }
}
